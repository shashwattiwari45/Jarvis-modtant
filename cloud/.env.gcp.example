# Jarvis Cloud service
OPENAI_API_KEY=replace-me
JARVIS_CLOUD_SECRET=replace-with-a-long-random-secret
JARVIS_CLOUD_MODEL=gpt-5-mini
JARVIS_CLOUD_DB=/tmp/jarvis_cloud.db

# Autonomous Instagram Cloud Run Job
INSTAGRAM_ACCESS_TOKEN=replace-me
INSTAGRAM_ACCOUNT_ID=replace-me
META_GRAPH_API_VERSION=v20.0
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
JARVIS_SOCIAL_MODEL=gpt-5-mini
JARVIS_INSTAGRAM_AUTOPUBLISH=false
JARVIS_INSTAGRAM_MIN_POST_INTERVAL_HOURS=20
JARVIS_INSTAGRAM_HIGH_QUALITY_RATE=0.15
JARVIS_INSTAGRAM_MEDIUM_QUALITY_RATE=0.65
JARVIS_INSTAGRAM_LOW_QUALITY_RATE=0.20
JARVIS_INSTAGRAM_IMAGE_SIZE=1024x1024
