OPENAI_API_KEY=your_openai_api_key
JARVIS_CLOUD_SECRET=generate_a_long_random_secret
JARVIS_CLOUD_MODEL=gpt-5.4-mini
JARVIS_REASONING_MODEL=gpt-5.4-mini
JARVIS_FAST_MODEL=gpt-5.4-nano
JARVIS_WEB_SEARCH_CONTEXT=medium
JARVIS_OWNER_ID=owner

# Recommended for Render: use a managed Postgres database so memory survives restarts/sleep.
DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite fallback for local development only.
JARVIS_CLOUD_DB=./jarvis_cloud.db

# Put the deployed Render URL in the Windows/Android client's environment:
# JARVIS_CLOUD_URL=https://your-service.onrender.com
# JARVIS_DEVICE_ID=your-device-name
